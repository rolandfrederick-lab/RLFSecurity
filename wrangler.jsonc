{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rlfsecurity",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Contact form: emails go through Cloudflare Email Routing to this verified address.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "rolandfrederick@gmail.com" }
  ],
  "vars": {
    "CONTACT_EMAIL_TO": "rolandfrederick@gmail.com",
    "CONTACT_SHOWN_TO": "rolandfrederick@rlfsecurity.com",
    // Replies from the staff app Inbox are sent from this address through Resend.
    // The Resend API key is a secret: add RESEND_API_KEY in the Cloudflare dashboard.
    "REPLY_FROM": "rolandfrederick@rlfsecurity.com",
    // Public values (same as public/app/config.js); the database rules protect the data.
    "SUPABASE_URL": "https://yovnncgvdfebhtrhlrqt.supabase.co",
    "SUPABASE_KEY": "sb_publishable_B49NyMpcIfP5D1aCQDiXTg_DQEtCMye"
  }
}
